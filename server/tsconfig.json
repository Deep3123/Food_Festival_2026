{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@types/*": ["types/*"],
      "@domain/*": ["domain/*"]
    }
  },
  "references": [{ "path": "../tsconfig.json" }],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
